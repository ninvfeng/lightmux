<?xml version="1.0" encoding="utf-8"?>
<!-- tmux 窗格分割：左竖条 + 底横条构成的负空间正好是 lightmux 的 L，右上半透明块是未激活窗格。
     不用 ">_" 提示符是因为那是所有终端 app 的通用符号（Termux/Termius/JuiceSSH 全一样），
     认不出是谁；窗格分割才是 tmux 独有的视觉语言。
     块之间 4dp 的 gap 就是 tmux 的 pane border，别填满。

     全部用实心块而非描边：描边在启动器缩到 48dp 时会糊，实心块不会。

     主体 46x46（31..77，笔画 14 / gap 4），最外点距中心 31.3dp，压在 66dp keyline（33dp）以内。
     别为了「显得饱满」放大：52x52 时最外点 35.5dp，只比 72dp 圆蒙版少 0.5dp，
     蒙版尺寸有厂商差异，那点余量等于随时被削角。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 右上：未激活窗格。alpha 而非另配一个暗色常量——主题图标(monochrome)会把整张图
         按 alpha 重新着色，写死暗色的话这块会和 L 撞成同一个颜色，L 就消失了 -->
    <path
        android:fillColor="#4EC9B0"
        android:fillAlpha="0.28"
        android:pathData="M52,31 H74 A3,3 0 0 1 77,34 V56 A3,3 0 0 1 74,59 H52 A3,3 0 0 1 49,56 V34 A3,3 0 0 1 52,31 Z" />
    <!-- L 的竖笔 -->
    <path
        android:fillColor="#4EC9B0"
        android:pathData="M34,31 H42 A3,3 0 0 1 45,34 V74 A3,3 0 0 1 42,77 H34 A3,3 0 0 1 31,74 V34 A3,3 0 0 1 34,31 Z" />
    <!-- L 的横笔 -->
    <path
        android:fillColor="#4EC9B0"
        android:pathData="M52,63 H74 A3,3 0 0 1 77,66 V74 A3,3 0 0 1 74,77 H52 A3,3 0 0 1 49,74 V66 A3,3 0 0 1 52,63 Z" />
</vector>
