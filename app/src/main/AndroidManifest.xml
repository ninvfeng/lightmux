<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 会话常驻：切后台后仍保持 SSH 连接与滚屏，靠前台服务不被系统回收。
         类型选 specialUse 而不是 dataSync —— 后者有 6 小时上限、语义也是「同步完就结束」，
         而我们要维持的是一条交互式远程 shell，用户可能挂一整天 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 只声明、**不主动申请**：那条常驻通知没有信息量，Android 13+ 默认不授权就不会显示，
         而服务与保活能力完全不受影响。声明保留着，是为了让想看的用户能在系统设置里自己打开 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 前台服务保得住进程，保不住网络：省电策略会在切后台几秒内掐掉后台联网，
         转发和终端跟着断。代码层绕不过去，只能把系统的授权入口递到用户面前，
         这条权限就是为了能直接拉起那个页面（见 BackgroundLimits） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 应用内更新：下载 APK 后拉起系统安装器 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".LightmuxApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lightmux">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|density|uiMode"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Lightmux"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.SessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <!-- Android 14 起 specialUse 必须附一句用途说明，给应用商店审核看 -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps interactive remote shell (SSH/tmux) connections and their scrollback alive while the user is away from the app." />
        </service>

        <!--
            安装会话的状态回调。必须在 manifest 里声明：安装真正落地时系统会杀掉本进程，
            运行时注册的接收器活不到那一刻。PendingIntent 显式指向本组件，不必导出。
        -->
        <receiver
            android:name=".update.UpdateInstallReceiver"
            android:exported="false" />
    </application>

</manifest>
